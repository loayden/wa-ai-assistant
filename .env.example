# FILE: .env.example
# [ROLE: DEVOPS ENGINEER]

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase PostgreSQL connection string)
DATABASE_URL=
DIRECT_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API (Meta)
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v19.0
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
# Set to "true" to use mock WhatsApp layer (for dev without Meta credentials)
WHATSAPP_MOCK_MODE=false
# Phase 9 social channels use the same Meta app:
# Facebook Page + Instagram webhook URL: https://YOUR_DOMAIN/api/webhooks/meta
# Webhook verify token: META_VERIFY_TOKEN, or same value as WHATSAPP_VERIFY_TOKEN

# Paymob
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Paymob dashboard payment method / card integration id. Required before real checkout.
# Paymob processed callback/webhook URL: https://YOUR_DOMAIN/api/webhooks/paymob
# Paymob response/redirect URL: https://YOUR_DOMAIN/api/billing/paymob-return
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_CURRENCY=EGP
PAYMOB_PRO_AMOUNT_CENTS=99900
PAYMOB_BUSINESS_AMOUNT_CENTS=249900

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=owner@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_EMAIL_REDIRECT_URL=http://localhost:3000/auth/confirm?next=/connect
CRON_SECRET=random_string_min_32_chars
NODE_ENV=development

# Sentry (optional locally, recommended in production)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=kallem

# Testing (non-production only)
E2E_AUTH_BYPASS_SECRET=

# Encryption (for WhatsApp access tokens)
ENCRYPTION_SECRET=exactly_32_random_chars_here_123
