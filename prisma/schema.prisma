// FILE: prisma/schema.prisma

// [ROLE: BACKEND ENGINEER]
// Decision: Prisma manages only the public application schema. `User.id` stores
// the Supabase Auth UUID, but it does not create a cross-schema foreign key to
// `auth.users`, avoiding Supabase-managed schema drift.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Enums keep subscription and message state constrained at the
// database layer while preserving readable values for API responses.
enum PlanTier {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  PROCESSING
  REPLIED
  FAILED
  IGNORED
}

enum OutboundMessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
  RETRYING
  BLOCKED
}

// [ROLE: BACKEND ENGINEER]
// Decision: The application user row mirrors Supabase Auth identity data and is
// the parent record for all tenant-scoped data.
model User {
  id                    String                 @id @db.Uuid
  email                 String                 @unique
  fullName              String?                @map("full_name")
  avatarUrl             String?                @map("avatar_url")
  isAdmin               Boolean                @default(false) @map("is_admin")
  planTier              PlanTier               @default(FREE) @map("plan_tier")
  paymentCustomerId     String?                @unique @map("stripe_customer_id")
  paymentSubscriptionId String?                @map("stripe_subscription_id")
  subscriptionStatus    SubscriptionStatus     @default(INACTIVE) @map("subscription_status")
  monthlyReplyCount     Int                    @default(0) @map("monthly_reply_count")
  onboardingCompleted   Boolean                @default(false) @map("onboarding_completed")
  trialEndsAt           DateTime?              @map("trial_ends_at")
  trialUsed             Boolean                @default(false) @map("trial_used")
  paidAt                DateTime?              @map("paid_at")
  usageAlert80SentAt    DateTime?              @map("usage_alert_80_sent_at")
  usageAlert100SentAt   DateTime?              @map("usage_alert_100_sent_at")
  replyCountResetAt     DateTime               @default(now()) @map("reply_count_reset_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  connections           WhatsAppConnection[]
  conversationHandoffs  ConversationHandoff[]
  aiCorrections         AiCorrection[]
  orders                Order[]
  products              Product[]
  routingRules          RoutingRule[]
  leads                 Lead[]
  knowledgeBaseEntries  KnowledgeBaseEntry[]
  messages              Message[]
  messageTemplates      MessageTemplate[]
  broadcasts            Broadcast[]
  settings              UserSettings?
  subscriptionEvents    SubscriptionEvent[]
  supportTickets        SupportTicket[]
  adminOutreach         AdminOutreach[]
  customerProfiles      CustomerProfile[]
  whatsappFlows         WhatsAppFlow[]
  flowResponses         FlowResponse[]
  appointments          Appointment[]
  instagramCommentLeads InstagramCommentLead[]
  instagramPostStats    InstagramPostStats[]
  outboundMessages      OutboundMessage[]
  auditLogs             AuditLog[]
  aiReplyTraces         AIReplyTrace[]
  readinessSnapshots    ReadinessSnapshot[]

  @@index([createdAt])
  @@index([planTier])
  @@index([subscriptionStatus])
  @@index([isAdmin])
  @@index([trialEndsAt])
  @@map("users")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Knowledge entries are tenant-owned by the app user instead of a new
// business table, preserving the current production schema and auth model.
model KnowledgeBaseEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@map("knowledge_base")
}

// [ROLE: BACKEND ENGINEER]
// Decision: WhatsApp connections are tenant-owned and cascade with the user so
// deleting an account removes credentials and linked message history.
model WhatsAppConnection {
  id                       String                 @id @default(uuid()) @db.Uuid
  userId                   String                 @map("user_id") @db.Uuid
  phoneNumberId            String                 @map("phone_number_id")
  businessAccountId        String                 @map("business_account_id")
  // WhatsApp access tokens must be encrypted before this field is written.
  accessToken              String                 @map("access_token")
  webhookVerifyToken       String                 @map("webhook_verify_token")
  ownerPhoneNumber         String?                @map("owner_phone_number")
  displayName              String?                @map("display_name")
  channel                  String                 @default("whatsapp")
  provider                 String                 @default("meta")
  facebookPageId           String?                @map("facebook_page_id")
  facebookPageName         String?                @map("facebook_page_name")
  facebookPagePicture      String?                @map("facebook_page_picture")
  instagramAccountId       String?                @map("instagram_account_id")
  instagramUsername        String?                @map("instagram_username")
  instagramProfilePicture  String?                @map("instagram_profile_picture")
  pageAccessTokenEncrypted String?                @map("page_access_token_encrypted")
  permissions              String[]               @default([])
  permissionStatus         String                 @default("unknown") @map("permission_status")
  lastVerifiedAt           DateTime?              @map("last_verified_at")
  webhookSubscribed        Boolean                @default(false) @map("webhook_subscribed")
  isActive                 Boolean                @default(false) @map("is_active")
  isVerified               Boolean                @default(false) @map("is_verified")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages                 Message[]
  conversationHandoffs     ConversationHandoff[]
  leads                    Lead[]
  messageTemplates         MessageTemplate[]
  broadcasts               Broadcast[]
  orders                   Order[]
  flowResponses            FlowResponse[]
  instagramCommentLeads    InstagramCommentLead[]
  instagramPostStats       InstagramPostStats[]
  outboundMessages         OutboundMessage[]
  aiReplyTraces            AIReplyTrace[]

  @@index([userId])
  @@index([userId, channel])
  @@index([channel])
  @@index([facebookPageId])
  @@index([instagramAccountId])
  @@index([createdAt])
  @@index([isActive])
  @@index([isVerified])
  @@map("whatsapp_connections")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Messages are scoped by user and connection, with idempotency enforced
// by WhatsApp's message id to make webhook retries safe.
model Message {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  connectionId        String             @map("connection_id") @db.Uuid
  waMessageId         String             @unique @map("wa_message_id")
  direction           MessageDirection
  fromNumber          String             @map("from_number")
  toNumber            String             @map("to_number")
  bodyText            String             @map("body_text")
  mediaUrl            String?            @map("media_url")
  mediaType           String?            @map("media_type")
  channel             String             @default("whatsapp")
  externalMessageId   String?            @map("external_message_id")
  externalThreadId    String?            @map("external_thread_id")
  senderName          String?            @map("sender_name")
  senderProfilePicUrl String?            @map("sender_profile_pic_url")
  status              MessageStatus      @default(RECEIVED)
  aiReplyText         String?            @map("ai_reply_text")
  aiModelUsed         String?            @map("ai_model_used")
  aiTokensUsed        Int?               @map("ai_tokens_used")
  metadata            Json               @default("{}")
  processedAt         DateTime?          @map("processed_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection          WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  leads               Lead[]
  outboundMessages    OutboundMessage[]
  aiReplyTraces       AIReplyTrace[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, channel])
  @@index([connectionId])
  @@index([channel])
  @@index([externalMessageId])
  @@index([externalThreadId])
  @@index([createdAt])
  @@index([status])
  @@index([waMessageId])
  @@map("messages")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Outbound delivery is tracked separately from visible messages so
// retries, provider failures, and manual sends have an auditable queue without
// changing the existing flat conversation model.
model OutboundMessage {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  connectionId      String                @map("connection_id") @db.Uuid
  relatedMessageId  String?               @map("related_message_id") @db.Uuid
  idempotencyKey    String                @unique @map("idempotency_key")
  channel           String
  direction         String
  senderId          String                @map("sender_id")
  recipientId       String                @map("recipient_id")
  bodyText          String                @map("body_text")
  externalThreadId  String?               @map("external_thread_id")
  status            OutboundMessageStatus @default(PENDING)
  attemptCount      Int                   @default(0) @map("attempt_count")
  maxAttempts       Int                   @default(3) @map("max_attempts")
  nextAttemptAt     DateTime?             @map("next_attempt_at")
  lastAttemptAt     DateTime?             @default(now()) @map("last_attempt_at")
  sentAt            DateTime?             @map("sent_at")
  providerMessageId String?               @map("provider_message_id")
  failureCode       String?               @map("failure_code")
  failureReason     String?               @map("failure_reason")
  failureActionHref String?               @map("failure_action_href")
  metadata          Json                  @default("{}")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection        WhatsAppConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  relatedMessage    Message?              @relation(fields: [relatedMessageId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([userId, status])
  @@index([connectionId, recipientId])
  @@index([relatedMessageId])
  @@index([createdAt])
  @@map("outbound_messages")
}

// [ROLE: SECURITY ENGINEER]
// Decision: Security-sensitive actions need an append-only tenant-scoped audit
// trail that stores context without storing provider tokens or raw payloads.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// [ROLE: BACKEND ENGINEER]
// Decision: AI reply traces are stored separately from messages so every
// generation attempt has durable evidence of context, confidence, and failure.
model AIReplyTrace {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  connectionId        String?             @map("connection_id") @db.Uuid
  messageId           String?             @map("message_id") @db.Uuid
  traceId             String              @map("trace_id")
  contextBundle       Json                @default("{}") @map("context_bundle")
  replyText           String?             @map("reply_text")
  confidence          Float?
  sources             Json                @default("[]")
  missingData         Json                @default("[]") @map("missing_data")
  needsHuman          Boolean             @default(false) @map("needs_human")
  suggestedAction     String?             @map("suggested_action")
  outsideWorkingHours Boolean             @default(false) @map("outside_working_hours")
  latencyMs           Int?                @map("latency_ms")
  model               String?
  tokensUsed          Int?                @map("tokens_used")
  failureReason       String?             @map("failure_reason")
  createdAt           DateTime            @default(now()) @map("created_at")
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection          WhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  message             Message?            @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([connectionId])
  @@index([messageId])
  @@index([traceId])
  @@map("ai_reply_traces")
}

// [ROLE: SRE]
// Decision: Webhook events are recorded before processing so provider retries,
// duplicates, and failed async work can be diagnosed without relying on logs.
model WebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  eventType       String    @map("event_type")
  providerEventId String?   @map("provider_event_id")
  rawPayload      Json      @default("{}") @map("raw_payload")
  processed       Boolean   @default(false)
  processedAt     DateTime? @map("processed_at")
  failureReason   String?   @map("failure_reason")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@index([provider, eventType, createdAt])
  @@index([processed, createdAt])
  @@map("webhook_events")
}

// [ROLE: PRODUCT ENGINEER]
// Decision: Readiness snapshots make launch scoring auditable over time and
// separate code/config gaps from owner-only external setup work.
model ReadinessSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  score         Int
  checks        Json     @default("[]")
  codeIssues    Json     @default("[]") @map("code_issues")
  manualActions Json     @default("[]") @map("manual_actions")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([score])
  @@map("readiness_snapshots")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Products are user-owned catalog items that the assistant can use to
// quote prices and create lightweight WhatsApp orders without adding a separate
// business table.
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  nameEn      String?  @map("name_en")
  description String?
  price       Int
  category    String?
  isAvailable Boolean  @default(true) @map("is_available")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
  @@index([userId, isAvailable])
  @@map("products")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Orders are tied to the current WhatsApp connection and customer
// phone because the production schema derives threads from messages rather than
// a conversations table.
model Order {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  connectionId      String             @map("connection_id") @db.Uuid
  customerPhone     String             @map("customer_phone")
  customerName      String?            @map("customer_name")
  customerAddress   String?            @map("customer_address")
  items             Json
  subtotal          Int
  status            String             @default("new")
  notes             String?
  paymentLink       String?            @map("payment_link")
  paymentLinkSentAt DateTime?          @map("payment_link_sent_at")
  paidAt            DateTime?          @map("paid_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection        WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([connectionId, customerPhone])
  @@map("orders")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Corrections are stored as business-specific examples, letting future
// AI prompts learn from owner edits without changing previous message records.
model AiCorrection {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  originalCustomerMessage String   @map("original_customer_message")
  wrongAiReply            String   @map("wrong_ai_reply")
  correctReply            String   @map("correct_reply")
  createdAt               DateTime @default(now()) @map("created_at")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_corrections")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Routing rules are explicit owner-controlled automation rules, kept
// user-scoped so message classification can pause AI, notify staff, or add
// extra instructions without introducing new permission boundaries.
model RoutingRule {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  name                String
  topic               String
  keywords            String[] @default([])
  action              String
  targetPhone         String?  @map("target_phone")
  targetEmail         String?  @map("target_email")
  customAiInstruction String?  @map("custom_ai_instruction")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, topic])
  @@map("routing_rules")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Leads are attached to the current tenant user and optionally to the
// message that triggered detection, preserving the existing flat message model.
model Lead {
  id                    String                 @id @default(uuid()) @db.Uuid
  userId                String                 @map("user_id") @db.Uuid
  messageId             String?                @map("message_id") @db.Uuid
  connectionId          String?                @map("connection_id") @db.Uuid
  customerPhone         String                 @map("customer_phone")
  customerName          String?                @map("customer_name")
  interest              String
  channel               String                 @default("whatsapp")
  externalId            String?                @map("external_id")
  senderName            String?                @map("sender_name")
  source                String                 @default("chat")
  status                String                 @default("new")
  detectedAt            DateTime               @default(now()) @map("detected_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection            WhatsAppConnection?    @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  message               Message?               @relation(fields: [messageId], references: [id], onDelete: SetNull)
  instagramCommentLeads InstagramCommentLead[]

  @@index([userId, detectedAt])
  @@index([userId, status])
  @@index([userId, channel])
  @@index([userId, externalId])
  @@index([connectionId, customerPhone])
  @@map("leads")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Handoff is stored per customer thread derived from connection and
// phone number because the production schema has no separate conversations table.
model ConversationHandoff {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  connectionId      String             @map("connection_id") @db.Uuid
  customerPhone     String             @map("customer_phone")
  active            Boolean            @default(false)
  handoffAt         DateTime?          @map("handoff_at")
  resumedAt         DateTime?          @map("resumed_at")
  resolvedAt        DateTime?          @map("resolved_at")
  rating            Int?
  ratingRequestedAt DateTime?          @map("rating_requested_at")
  notifiedEvents    String[]           @default([]) @map("notified_events")
  priority          String             @default("normal")
  tags              String[]           @default([])
  socialIntent      String?            @map("social_intent")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection        WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, connectionId, customerPhone])
  @@index([userId, active])
  @@index([userId, resolvedAt])
  @@index([connectionId, customerPhone])
  @@map("conversation_handoffs")
}

// [ROLE: BACKEND ENGINEER]
// Decision: User settings are one-to-one with the tenant user and cascade on
// account deletion to keep prompt behavior isolated per tenant.
model UserSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  systemPrompt          String   @default("You are a helpful business assistant for {businessName}. Your role is to respond\nto customer WhatsApp messages in a friendly, professional, and concise manner.\nAlways stay on topic. If you cannot help with something, politely direct the\ncustomer to contact a human agent. Respond in {language}. Keep replies under\n{maxReplyLength} characters.") @map("system_prompt")
  autoReplyEnabled      Boolean  @default(true) @map("auto_reply_enabled")
  language              String   @default("en")
  businessName          String?  @map("business_name")
  businessContext       String?  @map("business_context")
  fallbackMessage       String?  @map("fallback_message")
  maxReplyLength        Int      @default(300) @map("max_reply_length")
  workingHoursEnabled   Boolean  @default(false) @map("working_hours_enabled")
  workingHoursStart     String   @default("09:00") @map("working_hours_start")
  workingHoursEnd       String   @default("22:00") @map("working_hours_end")
  workingDays           String[] @default(["saturday", "sunday", "monday", "tuesday", "wednesday", "thursday"]) @map("working_days")
  offHoursMessage       String   @default("شكراً لتواصلك 🙏 نحن حالياً خارج أوقات العمل. سنرد عليك فور بدء الدوام.") @map("off_hours_message")
  timezone              String   @default("Africa/Cairo")
  csatEnabled           Boolean  @default(false) @map("csat_enabled")
  notificationPrefs     Json     @default("{\"angry\":true,\"lead\":true,\"handoff\":true,\"daily_summary\":false,\"weekly_report\":true,\"ai_failed\":true}") @map("notification_prefs")
  commentToDmEnabled    Boolean  @default(false) @map("comment_to_dm_enabled")
  commentToDmMessage    String   @default("مرحباً! 👋 شكراً لاهتمامك. كيف يمكنني مساعدتك؟") @map("comment_to_dm_message")
  instagramTone         String   @default("friendly") @map("instagram_tone")
  messengerTone         String   @default("professional") @map("messenger_tone")
  instagramInstructions String?  @map("instagram_instructions")
  messengerInstructions String?  @map("messenger_instructions")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("user_settings")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Payment events are append-only audit records scoped to the user;
// they cascade on account deletion to honor tenant data removal.
model SubscriptionEvent {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  paymentEventId String    @unique @map("stripe_event_id")
  eventType      String    @map("event_type")
  planTier       PlanTier  @map("plan_tier")
  status         String
  amount         Int?
  currency       String?
  periodStart    DateTime? @map("period_start")
  periodEnd      DateTime? @map("period_end")
  createdAt      DateTime  @default(now()) @map("created_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([eventType])
  @@index([planTier])
  @@index([status])
  @@map("subscription_events")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Templates are tenant-owned and optionally scoped to one WhatsApp
// connection. Status/category stay as text so production can adopt the feature
// without enum migrations fighting existing Supabase ownership.
model MessageTemplate {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  connectionId    String?             @map("connection_id") @db.Uuid
  name            String
  displayName     String              @map("display_name")
  category        String
  language        String              @default("ar")
  headerText      String?             @map("header_text")
  bodyText        String              @map("body_text")
  footerText      String?             @map("footer_text")
  buttonText      String?             @map("button_text")
  buttonUrl       String?             @map("button_url")
  metaTemplateId  String?             @map("meta_template_id")
  status          String              @default("draft")
  rejectionReason String?             @map("rejection_reason")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection      WhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  broadcasts      Broadcast[]

  @@unique([userId, name])
  @@index([userId, status])
  @@index([connectionId])
  @@map("message_templates")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Broadcasts keep campaign metadata separate from each recipient so
// progress can be shown without losing per-phone send errors.
model Broadcast {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  connectionId   String?              @map("connection_id") @db.Uuid
  templateId     String?              @map("template_id") @db.Uuid
  name           String
  parameters     Json                 @default("[]")
  recipientCount Int                  @default(0) @map("recipient_count")
  sentCount      Int                  @default(0) @map("sent_count")
  failedCount    Int                  @default(0) @map("failed_count")
  status         String               @default("draft")
  scheduledAt    DateTime?            @map("scheduled_at")
  startedAt      DateTime?            @map("started_at")
  completedAt    DateTime?            @map("completed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection     WhatsAppConnection?  @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  template       MessageTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients     BroadcastRecipient[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([connectionId])
  @@index([templateId])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id           String    @id @default(uuid()) @db.Uuid
  broadcastId  String    @map("broadcast_id") @db.Uuid
  phone        String
  name         String?
  status       String    @default("pending")
  errorMessage String?   @map("error_message")
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  broadcast    Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId, status])
  @@index([phone])
  @@map("broadcast_recipients")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Support tickets are first-party product support records scoped to
// the same tenant user model as the rest of the app, while admins can review
// and answer them through server-side authorization.
model SupportTicket {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  subject    String
  category   String
  priority   String          @default("normal")
  status     String          @default("open")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  resolvedAt DateTime?       @map("resolved_at")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   TicketMessage[]

  @@index([userId, createdAt])
  @@index([status, priority])
  @@map("support_tickets")
}

model TicketMessage {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @map("ticket_id") @db.Uuid
  sender    String
  content   String
  createdAt DateTime      @default(now()) @map("created_at")
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Admin outreach is a lightweight audit trail for manual owner
// messages sent from the private admin surface.
model AdminOutreach {
  id      String   @id @default(uuid()) @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  message String
  sentAt  DateTime @default(now()) @map("sent_at")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@map("admin_outreach")
}

// [ROLE: BACKEND ENGINEER]
// Decision: Customer profiles aggregate WhatsApp/Instagram customer context per
// tenant without changing the existing message ingestion model.
model CustomerProfile {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @map("user_id") @db.Uuid
  phone              String
  name               String?
  channel            String                @default("whatsapp")
  instagramId        String?               @map("instagram_id")
  messengerPsid      String?               @map("messenger_psid")
  instagramIgsid     String?               @map("instagram_igsid")
  instagramUsername  String?               @map("instagram_username")
  linkedProfileId    String?               @map("linked_profile_id") @db.Uuid
  isMerged           Boolean               @default(false) @map("is_merged")
  firstContactAt     DateTime              @default(now()) @map("first_contact_at")
  lastContactAt      DateTime              @default(now()) @map("last_contact_at")
  totalConversations Int                   @default(0) @map("total_conversations")
  totalMessagesSent  Int                   @default(0) @map("total_messages_sent")
  totalOrders        Int                   @default(0) @map("total_orders")
  totalSpentPiastres Int                   @default(0) @map("total_spent_piastres")
  dominantMood       String                @default("neutral") @map("dominant_mood")
  moodHistory        Json                  @default("[]") @map("mood_history")
  commonTopics       String[]              @default([]) @map("common_topics")
  notes              String?
  tags               String[]              @default([])
  isBlocked          Boolean               @default(false) @map("is_blocked")
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  facts              CustomerProfileFact[]
  linkedProfile      CustomerProfile?      @relation("CustomerProfileMerge", fields: [linkedProfileId], references: [id])
  mergedProfiles     CustomerProfile[]     @relation("CustomerProfileMerge")

  @@unique([userId, phone])
  @@index([userId, lastContactAt])
  @@index([userId, channel])
  @@index([userId, messengerPsid])
  @@index([userId, instagramIgsid])
  @@index([linkedProfileId])
  @@map("customer_profiles")
}

model CustomerProfileFact {
  id        String          @id @default(uuid()) @db.Uuid
  profileId String          @map("profile_id") @db.Uuid
  fact      String
  source    String          @default("ai")
  createdAt DateTime        @default(now()) @map("created_at")
  profile   CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@map("customer_profile_facts")
}

model InstagramCommentLead {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  connectionId  String             @map("connection_id") @db.Uuid
  commentId     String             @unique @map("comment_id")
  commentText   String             @map("comment_text")
  commenterId   String             @map("commenter_id")
  commenterName String?            @map("commenter_name")
  postId        String?            @map("post_id")
  postCaption   String?            @map("post_caption")
  isLead        Boolean            @default(false) @map("is_lead")
  dmSent        Boolean            @default(false) @map("dm_sent")
  dmMessageId   String?            @map("dm_message_id")
  leadId        String?            @map("lead_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection    WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  lead          Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, postId])
  @@index([connectionId])
  @@map("instagram_comment_leads")
}

model InstagramPostStats {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  connectionId  String             @map("connection_id") @db.Uuid
  postId        String             @map("post_id")
  postCaption   String?            @map("post_caption")
  postMediaUrl  String?            @map("post_media_url")
  postTimestamp DateTime?          @map("post_timestamp")
  commentCount  Int                @default(0) @map("comment_count")
  leadCount     Int                @default(0) @map("lead_count")
  dmCount       Int                @default(0) @map("dm_count")
  lastUpdatedAt DateTime           @default(now()) @map("last_updated_at")
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection    WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, lastUpdatedAt])
  @@index([connectionId])
  @@map("instagram_post_stats")
}

// [ROLE: BACKEND ENGINEER]
// Decision: WhatsApp flows are tenant-owned definitions; responses are stored
// separately so future automation can process appointments or forms safely.
model WhatsAppFlow {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  name            String
  type            String
  description     String?
  flowJson        Json           @default("{}") @map("flow_json")
  metaFlowId      String?        @map("meta_flow_id")
  status          String         @default("draft")
  triggerKeywords String[]       @default([]) @map("trigger_keywords")
  autoTrigger     Boolean        @default(false) @map("auto_trigger")
  responseCount   Int            @default(0) @map("response_count")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses       FlowResponse[]

  @@index([userId, status])
  @@index([userId, autoTrigger])
  @@map("whatsapp_flows")
}

model FlowResponse {
  id            String              @id @default(uuid()) @db.Uuid
  flowId        String              @map("flow_id") @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  connectionId  String?             @map("connection_id") @db.Uuid
  customerPhone String              @map("customer_phone")
  responseData  Json                @default("{}") @map("response_data")
  processed     Boolean             @default(false)
  createdAt     DateTime            @default(now()) @map("created_at")
  flow          WhatsAppFlow        @relation(fields: [flowId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection    WhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  appointments  Appointment[]

  @@index([userId, createdAt])
  @@index([flowId, createdAt])
  @@index([userId, processed])
  @@map("flow_responses")
}

model Appointment {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  customerPhone  String        @map("customer_phone")
  customerName   String?       @map("customer_name")
  service        String
  date           DateTime      @db.Date
  time           String
  notes          String?
  status         String        @default("pending")
  flowResponseId String?       @map("flow_response_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  flowResponse   FlowResponse? @relation(fields: [flowResponseId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, status])
  @@map("appointments")
}
