# FILE: .env.example
# [ROLE: DEVOPS ENGINEER]

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase PostgreSQL connection string)
DATABASE_URL=
DIRECT_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# WhatsApp Cloud API (Meta)
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v19.0
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
# Set to "true" to use mock WhatsApp layer (for dev without Meta credentials)
WHATSAPP_MOCK_MODE=false

# Paymob
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Paymob dashboard payment method / card integration id. Required before real checkout.
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_CURRENCY=EGP
PAYMOB_PRO_AMOUNT_CENTS=99900
PAYMOB_BUSINESS_AMOUNT_CENTS=249900

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_EMAIL_REDIRECT_URL=
NODE_ENV=development

# Testing (non-production only)
E2E_AUTH_BYPASS_SECRET=

# Encryption (for WhatsApp access tokens)
ENCRYPTION_SECRET=   # 32-character random string
