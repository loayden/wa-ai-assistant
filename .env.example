# FILE: .env.example
# [ROLE: DEVOPS ENGINEER]

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase PostgreSQL connection string)
DATABASE_URL=
DIRECT_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# WhatsApp Cloud API (Meta)
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v19.0
# Set to "true" to use mock WhatsApp layer (for dev without Meta credentials)
WHATSAPP_MOCK_MODE=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Testing (non-production only)
E2E_AUTH_BYPASS_SECRET=

# Encryption (for WhatsApp access tokens)
ENCRYPTION_SECRET=   # 32-character random string
